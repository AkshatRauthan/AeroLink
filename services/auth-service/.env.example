AUTH_READ_REPLICA_ENABLED=false
AUTH_SHARD_COUNT=1

AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=replace-with-a-local-secret

AUTH_SHARD0_PRIMARY_HOST=127.0.0.1
AUTH_SHARD0_PRIMARY_PORT=3306
AUTH_SHARD0_DB_NAME=aerolink_auth

# Required only when AUTH_READ_REPLICA_ENABLED=true.
AUTH_SHARD0_REPLICA_HOST=127.0.0.1
AUTH_SHARD0_REPLICA_PORT=3307
AUTH_SHARD0_REPLICA_DB_NAME=aerolink_auth


# Redis configuration for cache
AUTH_REDIS_HOST=127.0.0.1
AUTH_REDIS_PORT=6379
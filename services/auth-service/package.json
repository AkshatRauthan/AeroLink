{
    "name": "@aerolink/auth-service",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "tsc && tsc-alias",
        "dev": "ts-node-dev --respawn --require tsconfig-paths/register --project tsconfig.json ./src/index.ts",
        "db::migration:run": "ts-node --require tsconfig-paths/register --project tsconfig.json ./src/infrastructure/db/migrate.ts",
        "db::migration:create": "knex migrate:make --migrations-directory ./src/infrastructure/db/migrations -x ts"
    },
    "dependencies": {
        "@aerolink/shared": "workspace:*",
        "@grpc/grpc-js": "^1.14.4",
        "@grpc/proto-loader": "0.7.10",
        "argon2": "^0.44.0",
        "dotenv": "16.3.1",
        "express": "^4.22.2",
        "ioredis": "5.3.2",
        "jsonwebtoken": "9.0.2",
        "knex": "3.1.0",
        "mysql2": "^3.22.5",
        "ts-node": "^10.9.2",
        "zod": "3.22.4"
    },
    "devDependencies": {
        "@types/express": "4.17.21",
        "@types/jsonwebtoken": "9.0.5",
        "@types/node": "20.11.5",
        "ts-node-dev": "2.0.0",
        "tsc-alias": "1.8.8",
        "tsconfig-paths": "4.2.0",
        "typescript": "5.3.3"
    }
}

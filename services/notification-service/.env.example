NOTIFICATION_READ_REPLICA_ENABLED=false
NOTIFICATION_SHARD_COUNT=1

NOTIFICATION_DB_USER=notification_service
NOTIFICATION_DB_PASSWORD=replace-with-a-local-secret

NOTIFICATION_SHARD0_PRIMARY_HOST=127.0.0.1
NOTIFICATION_SHARD0_PRIMARY_PORT=3306
NOTIFICATION_SHARD0_DB_NAME=aerolink_notification


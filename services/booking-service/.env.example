BOOKING_READ_REPLICA_ENABLED=false
BOOKING_SHARD_COUNT=2

BOOKING_DB_USER=booking_service
BOOKING_DB_PASSWORD=replace-with-a-local-secret

BOOKING_SHARD0_PRIMARY_HOST=127.0.0.1
BOOKING_SHARD0_PRIMARY_PORT=3306
BOOKING_SHARD0_DB_NAME=aerolink_booking_shard0

BOOKING_SHARD1_PRIMARY_HOST=127.0.0.1
BOOKING_SHARD1_PRIMARY_PORT=3306
BOOKING_SHARD1_DB_NAME=aerolink_booking_shard1

# Required only when BOOKING_READ_REPLICA_ENABLED=true.
BOOKING_SHARD0_REPLICA_HOST=127.0.0.1
BOOKING_SHARD0_REPLICA_PORT=3307
BOOKING_SHARD0_REPLICA_DB_NAME=aerolink_booking_shard0

BOOKING_SHARD1_REPLICA_HOST=127.0.0.1
BOOKING_SHARD1_REPLICA_PORT=3307
BOOKING_SHARD1_REPLICA_DB_NAME=aerolink_booking_shard1
# BOOKING_REPLICA_DB_USER=booking_replica_reader
# BOOKING_REPLICA_DB_PASSWORD=replace-with-a-local-secret


# Redis configuration for cache
BOOKING_REDIS_HOST=127.0.0.1
BOOKING_REDIS_PORT=6379

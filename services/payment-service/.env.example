PAYMENT_READ_REPLICA_ENABLED=false
PAYMENT_SHARD_COUNT=1

PAYMENT_DB_USER=payment_service
PAYMENT_DB_PASSWORD=replace-with-a-local-secret

PAYMENT_SHARD0_PRIMARY_HOST=127.0.0.1
PAYMENT_SHARD0_PRIMARY_PORT=3306
PAYMENT_SHARD0_DB_NAME=aerolink_payment

# Required only when PAYMENT_READ_REPLICA_ENABLED=true.
PAYMENT_SHARD0_REPLICA_HOST=127.0.0.1
PAYMENT_SHARD0_REPLICA_PORT=3307
PAYMENT_SHARD0_REPLICA_DB_NAME=aerolink_payment


# Redis configuration for cache
PAYMENT_REDIS_HOST=127.0.0.1
PAYMENT_REDIS_PORT=6379
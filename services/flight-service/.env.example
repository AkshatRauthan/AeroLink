FLIGHT_READ_REPLICA_ENABLED=false
FLIGHT_SHARD_COUNT=1

FLIGHT_DB_USER=flight_service
FLIGHT_DB_PASSWORD=replace-with-a-local-secret

FLIGHT_SHARD0_PRIMARY_HOST=127.0.0.1
FLIGHT_SHARD0_PRIMARY_PORT=3306
FLIGHT_SHARD0_DB_NAME=aerolink_flight

# Required only when FLIGHT_READ_REPLICA_ENABLED=true.
FLIGHT_SHARD0_REPLICA_HOST=127.0.0.1
FLIGHT_SHARD0_REPLICA_PORT=3307
FLIGHT_SHARD0_REPLICA_DB_NAME=aerolink_flight
# FLIGHT_REPLICA_DB_USER=flight_replica_reader
# FLIGHT_REPLICA_DB_PASSWORD=replace-with-a-local-secret

# Redis configuration for cache
FLIGHT_REDIS_HOST=127.0.0.1
FLIGHT_REDIS_PORT=6379
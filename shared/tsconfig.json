{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "types": ["node"],
        "composite": true,
        "paths": {
            "@shared/*": [
                "./src/*"
            ],
            "@shared": [
                "./src"
            ]
        }
    },
    "include": [
        "src/**/*"
    ]
}
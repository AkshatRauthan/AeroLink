{
    "name": "@aerolink/shared",
    "version": "1.0.0",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "dev": "ts-node-dev --respawn --require tsconfig-paths/register --project tsconfig.json src/index.ts",
        "build": "tsc && tsc-alias && cp src/proto/*.proto dist/proto/"
    },
    "dependencies": {
        "@aws-sdk/client-secrets-manager": "^3.1075.0",
        "@grpc/grpc-js": "1.14.4",
        "@grpc/proto-loader": "0.7.10",
        "amqplib": "0.10.3",
        "dotenv": "16.3.1",
        "express": "4.22.2",
        "ioredis": "5.3.2",
        "kafkajs": "2.2.4",
        "knex": "3.1.0",
        "mysql2": "^3.22.5",
        "uuid": "^14.0.1",
        "winston": "3.11.0",
        "zod": "3.22.4"
    },
    "devDependencies": {
        "@types/amqplib": "0.10.4",
        "@types/node": "20.11.5",
        "@types/uuid": "^11.0.0",
        "ts-node-dev": "2.0.0",
        "tsc-alias": "1.8.8",
        "tsconfig-paths": "4.2.0",
        "typescript": "5.3.3"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./db": {
            "types": "./dist/db/index.d.ts",
            "default": "./dist/db/index.js"
        },
        "./cache": {
            "types": "./dist/cache/index.d.ts",
            "default": "./dist/cache/index.js"
        },
        "./messaging": {
            "types": "./dist/messaging/index.d.ts",
            "default": "./dist/messaging/index.js"
        },
        "./proto": {
            "types": "./dist/proto/index.d.ts",
            "default": "./dist/proto/index.js"
        }
}
}

{
    "compilerOptions": {
        "target": "ES2021",
        "module": "node16",
        "moduleResolution": "node16",
        "lib": [
            "ES2021"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true
    },
    "exclude": [
        "node_modules",
        "dist",
        "docs"
    ]
}
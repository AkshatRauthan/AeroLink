{
    "name": "aerolink",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@9.0.0",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "dev:env:up": "docker compose -f docker-compose.dev.yaml up -d",
        "dev:env:stop": "docker compose -f docker-compose.dev.yaml stop",
        "dev:env:start": "docker compose -f docker-compose.dev.yaml start",
        "dev:env:delete": "docker compose -f docker-compose.dev.yaml down"
    },
    "devDependencies": {
        "@types/express": "4.17.21",
        "@types/node": "20.11.5"
    },
    "dependencies": {
        "@types/cors": "^2.8.19",
        "cors": "^2.8.6",
        "http-status-codes": "^2.3.0"
    }
}
